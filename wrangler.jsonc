{
  // Deploy this site as pure static assets (the ./out folder produced by
  // `npm run build` with output:'export'). No Next.js server adapter / OpenNext:
  // every route is prerendered HTML, so Cloudflare just serves the files.
  "name": "math",
  "compatibility_date": "2024-11-01",
  // Attach the production domain (+ www) to this Worker. On deploy, wrangler
  // creates the Custom Domains and their proxied DNS records automatically,
  // now that the iblearnersacademy.com zone is active on this Cloudflare account.
  "routes": [
    { "pattern": "iblearnersacademy.com", "custom_domain": true },
    { "pattern": "www.iblearnersacademy.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    // Site uses trailingSlash:true, so /foo redirects to /foo/ (matches the
    // sitemap + canonical tags). Files with extensions (sitemap.xml, PDFs) are
    // unaffected.
    "html_handling": "force-trailing-slash",
    // Serve the exported 404 page for unknown paths.
    "not_found_handling": "404-page"
  }
}
